# Dependency directories
node_modules

# Environment variables file (if you're using .env)
.env

# Build files
# The image consumes a pre-built tarball (client/build.tar.gz) rather than
# building the React client inside the container; the target host lacks the
# RAM. The raw client/build/ tree on the dev machine is excluded from the
# build context — only the tarball is sent.
build
dist

# Log files
logs

# Database Tests
seed.js

# IDE and editor files
.vscode
.idea
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# npm debugging logs
npm-debug.log*

# Ignore node_modules directory for both api and client
**/node_modules

# Ignore environment variables files for both api and client
client/.env

# Ignore any build output or generated files
client/build
client/dist
# But DO ship the pre-built tarball into the build context.
!client/build.tar.gz

# Ignore any logs or runtime data
client/logs

# Ignore IDE and editor specific files
client/.vscode
client/.idea

# Ignore any local development files
client/.env.local

# Ignore any user-specific files
client/.env.local

# Ignore any dependencies installed using yarn
yarn.lock
