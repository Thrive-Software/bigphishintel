{
  "name": "client",
  "version": "0.2.1",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.2",
    "@mui/material": "^6.1.2",
    "@mui/styled-engine": "^6.1.2",
    "@mui/system": "^6.1.2",
    "@mui/x-data-grid": "^7.19.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@uiw/react-md-editor": "^4.0.11",
    "axios": "^1.7.7",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "dayjs": "^1.11.13",
    "dompurify": "^3.3.3",
    "jwt-decode": "^4.0.0",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "bump:patch": "npm version patch --no-git-tag-version",
    "write:version": "node -e \"const fs=require('fs');const v=require('./package.json').version;const d=new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'});fs.writeFileSync('../VERSION',v+'|'+d);\"",
    "package:build": "tar -czf build.tar.gz build",
    "build": "npm run bump:patch && npm run write:version && react-scripts build && npm run package:build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "jest": "^27.5.1",
    "react-scripts": "5.0.1"
  }
}
